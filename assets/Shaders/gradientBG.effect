CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
          - blend: true
      rasterizerState:
        cullMode: none
      properties:
        innerColor: { value: [0.0, 0.3, 0.6, 1.0], editor: { type: color } }
        outerColor: { value: [0.0, 0.0, 0.0, 1.0], editor: { type: color } }
}%

CCProgram vs %{
  precision highp float;
  #include <cc-global>
  #include <cc-local>

  in vec3 a_position;
  in vec2 a_texCoord; // ✅ CORRECT UV semantic
  out vec2 v_uv;

  void main () {
    v_uv = a_texCoord;
    gl_Position = cc_matViewProj * cc_matWorld * vec4(a_position, 1.0);
  }
}%

CCProgram fs %{
  precision highp float;
  #include <cc-global>
  #include <cc-local>

  in vec2 v_uv;
  layout(location = 0) out vec4 fragColor;

  uniform CustomUniforms {
    vec4 innerColor;
    vec4 outerColor;
  };

  void main () {
    vec2 center = vec2(0.5, 0.5);
    float dist = distance(v_uv, center); // radial falloff
    float radius = 0.5; // shrink or expand the gradient
    float t = clamp(dist / radius, 0.0, 1.0);
    fragColor = mix(innerColor, outerColor, t);
  }
}%
